# zsh options
setopt autocd
setopt share_history

# Disable XON/XOFF to allow push-line
stty -ixon

# Shell aliases

alias ls="eza --icons auto"
alias ll="eza --icons auto -l"
alias la="eza --icons auto -a"

# Git aliases

alias gst="git status"
alias gco="git checkout"
alias gcb="git checkout -b"
alias glg="git log"
alias ga="git add"
alias gcmsg="git commit -m"
alias gcn!="git commit -v --no-edit --amend"
alias gp="git push"
alias gpf="git push --force"
alias gd="git diff"
alias gds="git diff --staged"
alias gl="git pull"
alias gp="git push"
alias gcm="git checkout master"
alias gb="git branch"
alias grbi="git rebase --interactive"

# Various aliases

alias cm=chezmoi
alias f=fuck

# Paths

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="/opt/homebrew/opt/node@16/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"

# Autocomplete
autoload -U compinit && compinit
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)
source ~/.zsh/repos/fzf-tab/fzf-tab.plugin.zsh

[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# Tools

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(fnm env --use-on-cd)"
eval "$(fnm completions --shell zsh)"
eval "$(direnv hook zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval $(thefuck --alias)

conda_init() {
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<
}

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/yrocq/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

# bun completions
[ -s "/Users/yrocq/.bun/_bun" ] && source "/Users/yrocq/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

fastfetch